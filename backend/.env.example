# Optional: defaults to kudagiri.db in the backend folder.
DATABASE_URL=sqlite:///./kudagiri.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required: generate a random secret locally; do not commit your .env file.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
